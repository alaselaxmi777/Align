# ALIGN Backend Production Environment Configuration Template
# Copy this file to .env and configure your environment-specific settings.

# Environment Mode
ENVIRONMENT=production
DEBUG=False

# Database (PostgreSQL 16 + pgvector)
# Managed service format (Supabase/Neon/RDS):
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_cryptographically_secure_random_64_char_key_for_production
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_64_char_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://yourdomain.com,https://align-web.vercel.app

# Google OAuth 2.0 (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Neo4j Graph Database (Neo4j AuraDB or self-hosted)
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_aura_password

# Cloud Object Storage (Cloudflare R2 recommended for zero egress fees, or AWS S3)
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=align-media-prod
S3_REGION_NAME=auto
S3_ACCESS_KEY_ID=your_r2_or_s3_access_key
S3_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# SMTP Transactional Email (Resend / SendGrid / Postmark / Amazon SES / Gmail App Password)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM_EMAIL=auth@yourdomain.com
SMTP_USE_TLS=true
