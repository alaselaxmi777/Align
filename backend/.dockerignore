# Version control
.git/
.gitignore

# Environment files & secrets (NEVER copy into Docker image)
.env*
*.env
backend/.env*
*.dump
*.pem
*.key
*.cert

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Local media / test artifacts
uploads/
tmp/
*.log
