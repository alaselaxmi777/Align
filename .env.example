# ALIGN Application Environment Configuration Template
# Copy this file to .env and configure your environment-specific settings.

# Database (PostgreSQL + pgvector)
POSTGRES_DB=align_db
POSTGRES_USER=align_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://align_user:your_secure_db_password@localhost:5433/align_db

# Security & Authentication
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API Endpoint
VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Transactional Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=noreply@align.local
SMTP_USE_TLS=true

# External APIs
EVENTBRITE_API_KEY=your_eventbrite_api_key
EVENTBRITE_API_SECRET=your_eventbrite_api_secret
EVENTBRITE_PRIVATE_TOKEN=your_eventbrite_private_token
GITHUB_TOKEN=your_github_personal_access_token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
NOMINATIM_USER_AGENT=ALIGN-Platform/1.0 (+https://align.local)

# AI Assistant & LLM Providers (Optional)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
SERPAPI_API_KEY=your_serpapi_api_key

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Instagram API with Instagram Login (Meta - Business/Creator Accounts)
INSTAGRAM_ENABLED=false
INSTAGRAM_APP_ID=your_meta_instagram_app_id
INSTAGRAM_APP_SECRET=your_meta_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback
TOKEN_ENCRYPTION_KEY=generate_with_python_cryptography_fernet_generate_key

# Cloud Object Storage (AWS S3 / Cloudflare R2 / Supabase Storage)
# Options: local | s3 | r2 | supabase
STORAGE_PROVIDER=local
S3_BUCKET_NAME=your_storage_bucket
S3_REGION_NAME=auto
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com
